# XDG Base Directory defaults
# https://specifications.freedesktop.org/basedir/latest/
# https://wiki.archlinux.org/title/XDG_Base_Directory

# nonstandard - the spec only says distros should put
# $HOME/.local/bin in PATH
# but some tools respect the explicit var, e.g. uv
export XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/share}"

# == User Directories ==

# user-specific configurations, analagous to /etc
# macos GUIs prefer $HOME/Library/Preferences
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# user-specific non-essential (cached) data, analogous to /var/cache
# macos GUIs prefer $HOME/Library/Caches
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
# user-specific data files, analogous to /usr/share
# macos GUIs prefer $HOME/Library/Application\ Support
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
# user-specific state files (cross-session, less important/non-portable;
# e.g. logs, layout, history), analogous to /var/lib
# macos GUIs prefer $HOME/Library/Application\ Support
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# == System Directories ==

# fallback config search dirs
# colon separated
if [[ "$OSTYPE" == darwin* ]]; then
  # macos GUIs prefer $HOME/Library/Preferences:/Library/Application\ Support:/Library/Preferences
  export XDG_CONFIG_DIRS=""
else
  export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"
fi
# fallback data search dirs
# colon separated
# exported by typeset below
# macos GUIs prefer /Library/Application\ Support:$HOME/Library/Application\ Support
: "${XDG_DATA_DIRS:=/usr/local/share:/usr/share}"

# Homebrew prefix: /opt/homebrew (Apple Silicon), /usr/local (Intel),
# /home/linuxbrew/.linuxbrew (Linuxbrew)
_brew_prefix=""
if [[ "$OSTYPE" == darwin* ]]; then
  if   [[ -x /opt/homebrew/bin/brew ]]; then _brew_prefix=/opt/homebrew
  elif [[ -x /usr/local/bin/brew    ]]; then _brew_prefix=/usr/local
  fi
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  _brew_prefix=/home/linuxbrew/.linuxbrew
fi

# Tie XDG_DATA_DIRS to an array with unique elements (-U), so the brew share
# dir is prepended without creating duplicates on Intel, where it's
# already /usr/local/share.
# -T keeps lhs scalar and rhs array in sync - changing one changes the other.
# -x exports.
if (( ! ${+xdg_data_dirs} )); then
  typeset -TUx XDG_DATA_DIRS xdg_data_dirs
fi
[[ -n "$_brew_prefix" ]] && xdg_data_dirs=("$_brew_prefix/share" $xdg_data_dirs)
unset _brew_prefix

# XDG_RUNTIME_DIR has no spec-defined default;
# it's normally set by the login system (pam_systemd, systemd-logind) on Linux.
# It's 0700, bound to login session (created on login, removed & destroyed on logout),
# always local, never shared, and a fully Unix-like FS.
# macOS doesn't set it, so fall back to a per-user directory.
if [[ -z "$XDG_RUNTIME_DIR" ]]; then
  if [[ "$OSTYPE" == darwin* ]]; then
    # NOTE: default $TMPDIR env var seems to always end in '/'
    export XDG_RUNTIME_DIR="${TMPDIR:-/tmp/}xdg-runtime-$UID"
  else
    export XDG_RUNTIME_DIR="/tmp/xdg-runtime-$UID"
  fi
fi
