# XDG Base Directory defaults (https://specifications.freedesktop.org/basedir-spec/latest/)
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"

# XDG_RUNTIME_DIR has no spec-defined default; it's normally set by the login
# system (systemd-logind) on Linux. macOS doesn't set it, so fall back to a
# per-user directory with 0700 permissions, as the spec requires.
if [[ -z "$XDG_RUNTIME_DIR" ]]; then
  if [[ "$OSTYPE" == darwin* ]]; then
    export XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/xdg-runtime-$UID"
  else
    export XDG_RUNTIME_DIR="/tmp/xdg-runtime-$UID"
  fi
fi
