#!/usr/bin/env bash

# taken from https://github.com/wimpysworld/nix-config/blob/d429c60e8cc0c464065b91d8e7e5922a8a6d95e5/home-manager/_mixins/desktop/hyprland/fuzzel/fuzzel-hyprpicker.sh

ICONS_DIR="$SUPERHOME/data/colors"

DRACULA_THEME=(
  "background,282A36"
  "current line,6272A4"
  "selection,44475A"
  "foreground,F8F8F2"
  "comment,6272A4"
  "red,FF5555"
  "orange,FFB86C"
  "yellow,F1FA8C"
  "green,50FA7B"
  "cyan,8BE9FD"
  "purple,BD93F9"
  "pink,FF79C6"
)

gui=1
pound=1
lower=0
BACK_STATUS="10"
color_selection=''
CALL_NEXT="main"

command -v fuzzel >/dev/null && has_fuzzel=1 || has_fuzzel=0
command -v fzf >/dev/null && has_fzf=1 || has_fzf=0
command -v wl-copy >/dev/null && has_clipboard=1 || has_clipboard=0
command -v wtype >/dev/null && has_type=1 || has_type=0
command -v notify-send >/dev/null && silent=0 || silent=1

if [ "${has_fuzzel}" -eq 0 ] && [ "${has_fzf}" -eq 0 ]; then
  printf 'Error: You need either fuzzel or fzf to run this program.' 1>&2
  exit 1
fi

show_help() {
  printf '%s: interactively search, type, copy, or print theme colors.\n\n' "${0}"
  printf 'Usage: %s [OPTION]\n\n' "${0}"
  printf 'OPTION:\n'
  printf '\t-g\tUse fuzzel for selecting colors (default).\n'
  printf '\t-t\tUse fzf for selecting colors.\n'
  printf '\t-s\tDo not show notification in (use with -g)\n'
  printf '\t-c\tDo not prefix with # character\n'
  printf '\t-l\tConvert to lowercase\n'
  printf '\t-h\tPrint this message and exit.\n'
  printf '\n'
  printf 'NOTE: mac is essentially limited to:\n'
  printf '%s -t\n' "${0}"
}

while getopts 'gtsclh:' option; do
  case "${option}" in
  g)
    gui=1
    ;;
  t)
    gui=0
    ;;
  s)
    silent=1
    ;;
  c)
    pound=0
    ;;
  l)
    lower=1
    ;;
  h)
    show_help
    exit 0
    ;;
  *)
    show_help
    exit 66
    ;;
  esac
done
shift $((OPTIND - 1))

if ! [ -d "${ICONS_DIR}" ]; then
  mkdir -vp "$ICONS_DIR"
fi

function create_eye_dropper_svg() {
  local color="#C8D1EE"
  local icon_path="$ICONS_DIR/eyedropper.svg"

  # Create an SVG for the eyedropper icon if it doesn't exist
  if [ ! -f "$icon_path" ]; then
    cat >"$icon_path" <<EOF
<svg fill="$color" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
  <g id="eyedropper">
    <path
      id="eyedropper_path"
      d="M223.99658,67.50391a35.73557,35.73557,0,0,0-11.26172-25.66114c-14.01806-13.2705-36.71875-12.771-50.60254,1.11328L140.18408,64.90479a24.02939,24.02939,0,0,0-33.15429.75195L100,72.68652a16.01779,16.01779,0,0,0,0,22.627l2.05908,2.05908L51.71533,147.71582a40.15638,40.15638,0,0,0-11.01074,35.771l-9.78271,22.40869a13.66329,13.66329,0,0,0,2.87744,15.21728,15.915,15.915,0,0,0,11.27929,4.70313,16.077,16.077,0,0,0,6.43555-1.353l20.999-9.16748a40.15391,40.15391,0,0,0,35.771-11.01123l50.34326-50.34326L160.68652,156a16.01779,16.01779,0,0,0,22.627,0l7.02978-7.02979a24.02843,24.02843,0,0,0,.752-33.15429l22.36036-22.36035A35.71726,35.71726,0,0,0,223.99658,67.50391ZM96.9707,192.9707a24.09567,24.09567,0,0,1-23.1914,6.21436,8.0052,8.0052,0,0,0-5.26416.39746L47.044,208.95605l9.37353-21.47119a8.00234,8.00234,0,0,0,.39746-5.26416,24.0986,24.0986,0,0,1,6.21436-23.1914L113.37256,108.686l33.9414,33.9414Z"
    />
  </g>
</svg>
EOF
  fi
}

function generate_svg_icon() {
  local colour="$1"
  local icon_path="$ICONS_DIR/$colour.svg"

  # create an svg for the colour if it doesn't exist
  if [ ! -f "$icon_path" ]; then
    cat >"$icon_path" <<EOF
<svg width="128" height="128" xmlns="http://www.w3.org/2000/svg">
  <rect width="128" height="128" fill="#$colour" />
</svg>
EOF
  fi
}

function build_fuzzel_menu() {
  # echo -e "Pick a colour\0icon\x1f$ICONS_DIR/eyedropper.svg"
  for item_pair in "${DRACULA_THEME[@]}"; do
    IFS=',' read -r item_text item_hex <<<"$item_pair"

    generate_svg_icon "${item_hex}"
    echo -e "${item_hex}\t${item_text}\0icon\x1f${ICONS_DIR}/${item_hex}.svg"
  done
}

function build_fzf_menu() {
  # echo -e "Pick a colour\0icon\x1f$ICONS_DIR/eyedropper.svg"
  for item_pair in "${DRACULA_THEME[@]}"; do
    IFS=',' read -r item_text item_hex <<<"$item_pair"

    generate_svg_icon "${item_hex}"
    echo -e "${item_hex}\t${item_text}"
  done
}

function get_fzf_options() {
  printf 'Press Enter key to print the color'
  [ "${has_clipboard}" -eq 1 ] && printf '\nCtrl-a:\tCopy color to clipboard'
  [ "${has_type}" -eq 1 ] && printf '\nCtrl-b:\tType color to focused window'
}

function get_fuzzel_options() {
  [ "${has_type}" -eq 1 ] && printf 'Autotype\n'
  [ "${has_clipboard}" -eq 1 ] && printf 'Copy\n'
  printf 'Print'
}

function process_selection() {
  if [ "${lower}" -eq 1 ]; then
    color_selection="${color_selection,,}"
  fi
  if [ "${pound}" -eq 1 ]; then
    color_selection="#${color_selection}"
  fi
}

function main() {
  if [ "${gui}" -eq 0 ]; then # fzf
    if [ "${has_fzf}" -eq 0 ]; then
      printf 'Error: You need fzf to run in non-gui mode.\n'
      show_help
      exit 1
    fi

    header=$(get_fzf_options)
    color_selection="$(
      build_fzf_menu |
        fzf \
          --accept-nth=1 \
          --with-nth=2 \
          --delimiter='\t' \
          --header="$header" \
          --bind 'ctrl-a:become(printf "%s" {1} && exit 10)' \
          --bind 'ctrl-b:become(printf "%s: {1} && exit 11)'
    )"

    exit_code=$?
    [ -z "${color_selection}" ] && exit 130

    process_selection

    case "${exit_code}" in
    0)
      mode="Print"
      ;;
    10)
      [ "${has_clipboard}" -eq 1 ] && mode="Copy"
      ;;
    11)
      [ "${has_type}" -eq 1 ] && mode="Autotype"
      ;;
    esac
  elif [ "${gui}" -eq 1 ]; then # fuzzel
    if [ "${has_fuzzel}" -eq 0 ]; then
      printf 'Error: You need fuzzel to run in gui mode.\n'
      show_help
      exit 1
    fi

    #create_eye_dropper_svg
    color_selection=$(build_fuzzel_menu | fuzzel --dmenu --width=25 --accept-nth=1 --with-nth=2)

    COLOR_RES_STATUS="$?"
    if [ "${COLOR_RES_STATUS}" = "${BACK_STATUS}" ]; then
      exec "$SUPERHOME/bin/fuzzelpicker"
    fi

    [ -z "${color_selection}" ] && exit 130

    process_selection

    modes=$(get_fuzzel_options)

    if [ "${modes}" = "Print" ]; then
      mode="${modes}"
    else
      mode=$(printf '%s' "${modes}" | fuzzel --width=25 --dmenu --log-level=none --placeholder="Action?")

      COLOR_RES_STATUS="$?"
      if [ "${COLOR_RES_STATUS}" = "${BACK_STATUS}" ]; then
        CALL_NEXT="main"
        return
      fi
    fi

    [ -z "${mode}" ] && exit 130
  fi

  case "${mode}" in
  "Autotype")
    if [ "${has_type}" -eq 0 ]; then
      printf 'Error: command "wtype" not found' 1>&2
      exit 1
    fi

    wtype "${color_selection}"
    ;;
  "Copy")
    if [ "${has_clipboard}" -eq 0 ]; then
      printf 'Error: command "wl-copy" not found' 1>&2
      exit 1
    fi

    wl-copy "${color_selection}"
    if [ "${gui}" -eq 1 ]; then
      if [ "${silent}" -eq 0 ]; then
        notify-send "${0}" "${color_selection} Copied!"
      fi
      exit 0
    fi

    printf '%s %s Copied!' "${0}" "${color_selection}"
    ;;
  "Print")
    printf '%s' "${color_selection}"
    exit 0
    ;;
  *)
    # This would never happen
    printf 'Unknown option selected' 1>&2
    exit 66
    ;;
  esac
}

while [ ! -z "${CALL_NEXT}" ]; do
  CALL_NOW="${CALL_NEXT}"
  CALL_NEXT=''
  "${CALL_NOW}"
done
