#!/usr/bin/env zsh

BACK_STATUS="10" # custom-1
FORW_STATUS="11" # custom-2, unused but kept for completeless
CALL_NEXT="choose_submenu"

# "🢖" is U+1F896 (rightwards white arrow within triangle arrowhead)
# https://fonts.google.com/noto/specimen/Noto+Sans+Symbols+2?preview.text=%F0%9F%A2%96&specimen.preview.text=%F0%9F%A2%96
  APPS=" Apps       🢖"
 EMOJI="󰞅 Emoji      🢖"
   IPC="󱅰 IPC        🢖"
 NIGHT="󰒲 Night      🢖"
SCREEN=" Screencap  🢖"

function choose_submenu() {
PICKER_RES=$(cat <<EOF | fuzzel --dmenu
${APPS}
${EMOJI}
${IPC}
${NIGHT}
${SCREEN}
EOF
)

if [ -z "${PICKER_RES}" ]; then
  exit 0
elif [ "${PICKER_RES}" = "${APPS}" ]; then
  # disable alt-h going back, make it cancel instead
  fuzzel --override=key-bindings.custom-1="Mod1+1" --override=key-bindings.cancel="Escape Control+g Control+c Control+bracketleft Mod1+h"
elif [ "${PICKER_RES}" = "${EMOJI}" ]; then
  $SUPERHOME/bin/fuzzmoji -p $SUPERHOME/data/emoji-list
elif [ "${PICKER_RES}" = "${IPC}" ]; then
  choose_ipc
elif [ "${PICKER_RES}" = "${NIGHT}" ]; then
  choose_night
elif [ "${PICKER_RES}" = "${SCREEN}" ]; then
  choose_screencap
else
  exit 1
fi
}

function choose_ipc() {
# https://malpenzibo.github.io/ashell/docs/configuration/main#visibility-toggle
IPC_TGL_ASHELL="Toggle ashell"
CLI_FNOTT_DISMISS="Notifications: dismiss all"

IPC_RES=$(cat <<EOF | fuzzel --dmenu
${IPC_TGL_ASHELL}
${CLI_FNOTT_DISMISS}
EOF
)

IPC_RES_STATUS="$?"

if [ "${IPC_RES_STATUS}" = "${BACK_STATUS}" ]; then
  CALL_NEXT="${funcstack[2]}"
elif [ -z "${IPC_RES}" ]; then
  exit 0
elif [ "${IPC_RES}" = "${IPC_TGL_ASHELL}" ]; then
  ashell msg toggle-visibility
elif [ "${IPC_RES}" = "${CLI_FNOTT_DISMISS}" ]; then
  fnottctl dismiss all
else
  exit 1
fi
}

function choose_night() {
SUSPEND_ME="󰖔 Suspend"
HIBERNATE_ME="󰜗 Hibernate"
REBOOT_ME="󰑓 Reboot"
SHUTDOWN_ME="󰐥 Shutdown"
LOGOUT_ME="󰍃 Logout"
LOCK_ME=" Lock"

NIGHT_RES=$(cat <<EOF | fuzzel --dmenu
${SUSPEND_ME}
${HIBERNATE_ME}
${REBOOT_ME}
${SHUTDOWN_ME}
${LOGOUT_ME}
${LOCK_ME}
EOF
)

NIGHT_RES_STATUS="$?"

if [ "${NIGHT_RES_STATUS}" = "${BACK_STATUS}" ]; then
  CALL_NEXT="${funcstack[2]}"
elif [ -z "${NIGHT_RES}" ]; then
  exit 0
elif [ "${NIGHT_RES}" = "${SUSPEND_ME}" ]; then
  systemctl suspend
elif [ "${NIGHT_RES}" = "${HIBERNATE_ME}" ]; then
  systemctl hibernate
elif [ "${NIGHT_RES}" = "${REBOOT_ME}" ]; then
  hyprshutdown -t 'Rebooting...' --post-cmd 'systemctl reboot'
elif [ "${NIGHT_RES}" = "${SHUTDOWN_ME}" ]; then
  hyprshutdown -t 'Shutting down...' --post-cmd 'shutdown now'
elif [ "${NIGHT_RES}" = "${LOGOUT_ME}" ]; then
  hyprshutdown -t 'Logging out...'
elif [ "${NIGHT_RES}" = "${LOCK_ME}" ]; then
  waylock -ignore-empty-password -init-color 0x282A36 -input-color 0xBD93F9 -input-alt-color 0xBD93F9 -fail-color 0xFF5555
else
  exit 1
fi
}

function ensure_dir() {
  THE_DIR="${1}"
  if [ ! -d "${THE_DIR}" ]; then
    mkdir -vp "${THE_DIR}"
  fi
}
function choose_screencap() {
OUTPUT_DIR="${HOME}/pictures/screencaps"
FILENAME="$(date +'screenshot_%Y-%m-%d_%H:%M:%S.png')"

MONITOR="󰍹 Monitor"
WINDOW="󰨝 Choose Window"
ACTIVE=" Active Window"
REGION="󰀁 Region"

MONITOR_ANNOT="󱋆 Monitor annotated"
WINDOW_ANNOT="󱥈 Choose Window annotated"
ACTIVE_ANNOT="󰘙 Active Window annotated"
REGION_ANNOT="󱣙 Region annotated"

SCREEN_RES=$(cat <<EOF | fuzzel --dmenu
${MONITOR}
${WINDOW}
${ACTIVE}
${REGION}
${MONITOR_ANNOT}
${WINDOW_ANNOT}
${ACTIVE_ANNOT}
${REGION_ANNOT}
EOF
)

SCREEN_RES_STATUS="$?"

# NOTE: `hyprctl monitors` gives OUTPUT_NAME (e.g. DP-4 or eDP-1)
# so instead of `-m active -m ...` it can be `-m DP-4 -m ...`

if [ "${SCREEN_RES_STATUS}" = "${BACK_STATUS}" ]; then
  CALL_NEXT="${funcstack[2]}"
elif [ -z "${SCREEN_RES}" ]; then
  exit 0
elif [ "${SCREEN_RES}" = "${MONITOR}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -m active -m output -o "${OUTPUT_DIR}" -f "${FILENAME}"
elif [ "${SCREEN_RES}" = "${WINDOW}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -m window -o "${OUTPUT_DIR}" -f "${FILENAME}"
elif [ "${SCREEN_RES}" = "${ACTIVE}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -d -m active -m window -o "${OUTPUT_DIR}" -f "${FILENAME}"
elif [ "${SCREEN_RES}" = "${REGION}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -m region -o "${OUTPUT_DIR}" -f "${FILENAME}"
elif [ "${SCREEN_RES}" = "${MONITOR_ANNOT}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -m active -m output --raw | satty -o "${OUTPUT_DIR}/${FILENAME}" --floating-hack --filename -
elif [ "${SCREEN_RES}" = "${WINDOW_ANNOT}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -m window --raw | satty -o "${OUTPUT_DIR}/${FILENAME}" --floating-hack --filename -
elif [ "${SCREEN_RES}" = "${ACTIVE_ANNOT}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -m active -m window --raw | satty -o "${OUTPUT_DIR}/${FILENAME}" --floating-hack --filename -
elif [ "${SCREEN_RES}" = "${REGION_ANNOT}" ]; then
  ensure_dir "${OUTPUT_DIR}"
  $SUPERHOME/bin/hyprshot -m region --raw | satty -o "${OUTPUT_DIR}/${FILENAME}" --floating-hack --filename -
else
  exit 1
fi
}

while [ ! -z "${CALL_NEXT}" ]; do
  CALL_NOW="${CALL_NEXT}"
  CALL_NEXT=""
  "${CALL_NOW}"
done
