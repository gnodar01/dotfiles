#!/usr/bin/env zsh

 APPS="Apps  🢖"
EMOJI="Emoji 🢖"

PICKER_RES=$(cat <<EOF | fuzzel --dmenu
${APPS}
${EMOJI}
EOF
)

if [ -z ${PICKER_RES} ]; then
  exit 0
elif [ ${PICKER_RES} = ${APPS} ]; then
  fuzzel
elif [ ${PICKER_RES} = ${EMOJI} ]; then
  $SUPERHOME/bin/fuzzmoji -p $SUPERHOME/data/emoji-list
else
  exit 1
fi
