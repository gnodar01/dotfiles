# A Cargo package’s source: is a git URL (https://, ssh://
# or git://) and is installed with cargo install --git.
# The name is the crate’s package name from its Cargo.toml,
# which is not always the name of the repository or of the
# binary it installs, so brew bundle dump output is
# the reliable thing to copy. A branch, tag or revision
# chosen when the package was installed is carried in the
# URL as ?branch=, ?tag= or ?rev=

# cargo "ripgrep"
# cargo "bat", source: "https://github.com/sharkdp/bat"

# uv tools use the installed python or python@ formula with
# the highest major/minor Python version, including keg-only
# versions. If no Homebrew Python is installed, uv selects
# Python as sual. Already-installed tools keep their existing
# Python until reinstalled.

# uv "mkdocs"
# uv "ruff", source: "git+https://github.com/astral-sh/ruff.git"

