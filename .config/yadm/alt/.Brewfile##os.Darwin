# `brew bundle` = `brew bundle install`
# `brew bundle install`
#   `brew bundle --global`: install from `~/.Brewfile`
# `brew bundle check`: check if `brew bundle` will install anything
#   common idiom: `brew bundle check || brew bundle install`
# `brew bundle dump`: Homebrew's installed-state snapshot
#   `--global --force` dumps to `~/.Brewfile`
#   `--file=<file_path>` dumps to `<file_path>`
#   may stop without writing, if package discovery fails
# `brew bundle cleanup`: clenaup after dump
#    e.g. `brew bundle cleanup --global --force`
#    removes packages not listed in `~/.Brewfile`, and revokes manual trust declerations
#    `--file=<file_path>` works the same for `<file_path>`
# `brew bundle list`: list of formulae in Brewfile
#    `--cask` for casks, etc.
# `brew bundle edit`: open Brewfile in editor
# `brew bundle add <pkg>`: add entry to brewfile
# `brew bundle remove <pkg>`: remove entry from brewfile
# `brew bundle exec`: run a command in environment customised by Brewfile
#   `--check` to avoid separate `brew bundle check`
#   `--install` to avoid separate `brew bundle install`
#   `--services` to start services for just `exec` lifetime
# `brew bundle sh`: like `brew bundle exec` but runs interactive shell of choice
#   same args as `exec`
# `brew bundle env`: dumps environment variables
#   `eval "$(brew bundle env)"`
#   same args as `exec`
# `brew bundle upgrade`: request upgrades
#   `brew bundle --upgrade-formulae <pkg>`
# `--no-upgrade` to avoid upgrades
#   or pin specific packages

#############################################################
# Options                                                   #
#############################################################

# cask_args:
#   set arguments passed to all `brew install --cask` commands for `cask "..."`
#   pass `--appdir=~/Applications` and `--require_sha`
cask_args appdir: "~/Applications", require_sha: true

# Sets an environment variable to be used e.g. inside `brew bundle exec` or `system` commands in the `Brewfile`.
# Note: HOMEBREW_PREFIX/bin is _not_ in the `PATH` by default so you can set it this way.
# ENV["SOME_ENV_VAR"] = "some_value"

#############################################################
# Taps                                                      #
#############################################################

## Examples                                                ##

# Trusts the tap so Homebrew loads it when tap trust is required.
# This works on `tap`, `brew` and `cask` entries.
# tap "user/repository", trusted: true

# Trusts only named formulae, casks or commands from a tap.
# tap "user/repository", trusted: {
#   formula:  "formula",
#   formulae: ["another-formula"],
#   cask:     "cask",
#   casks:    ["another-cask"],
#   command:  "command",
#   commands: ["another-command"],
# }

# Run `brew tap` with a custom URL
# tap "user/tap-repository", "https://user@bitbucket.org/user/homebrew-tap-repository.git"

## Essential                                               ##

#############################################################
# Command Line                                              #
#############################################################

## Examples                                                ##

# Trusts the formula so Homebrew loads it when tap trust is required.
# This works on `tap`, `brew` and `cask` entries.
# brew "user/repository/formula", trusted: true

# Pass options to non-Homebrew/core formulae e.g. `brew install denji/nginx/nginx-full --with-rmtp`
# This also runs `brew link --overwrite nginx-full` and `brew services restart nginx-full` afterwards.
# brew "denji/nginx/nginx-full", link: :overwrite, args: ["with-rmtp"], restart_service: :always

# Runs `brew install mysql@5.6`, `brew services restart mysql@5.6` only if it was installed or upgraded,
# `brew link mysql@5.6` and `brew unlink mysql` (if `mysql` is installed)
# brew "mysql@5.6", restart_service: :changed, link: true, conflicts_with: ["mysql"]

# Runs `brew install postgresql@16` and then runs a postinstall command if `postgresql@16` was installed or upgraded.
# brew "postgresql@16", postinstall: "${HOMEBREW_PREFIX}/opt/postgresql@16/bin/postgres -D ${HOMEBREW_PREFIX}/var/postgresql@16"

# Runs `brew install ruby` and, afterwards, writes the installed version to the '.ruby-version` file.
# brew "ruby", version_file: ".ruby-version"

